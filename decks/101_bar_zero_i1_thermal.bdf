$ Uniform temperature rise of 100 on CBARs with I1 blank (zero).
$ Elements 1-2 are fixed at both ends, elements 3-4 are a cantilever that expands freely.
SOL 101
CEND
TITLE = 101_bar_zero_i1_thermal
ECHO = NONE
SPC = 1
TEMPERATURE(LOAD) = 2
DISPLACEMENT = ALL
SPCFORCES = ALL
STRESS = ALL
ELFORCE = ALL
BEGIN BULK
PARAM,POST,-1
MAT1,1,2.E+11,,0.3,0.,1.2E-05,0.0
PBAR,1,1,0.0001,,8.333333333E-10,1.406E-09,,,+P1
+P1,0.005,0.005,-0.005,0.005,-0.005,-0.005,0.005,-0.005
GRID,1,,0.,0.,0.0
GRID,2,,0.5,0.,0.0
GRID,3,,1.,0.,0.0
CBAR,1,1,1,2,0.0,1.0,0.0
CBAR,2,1,2,3,0.0,1.0,0.0
GRID,4,,0.,1.,0.0
GRID,5,,0.5,1.,0.0
GRID,6,,1.,1.,0.0
CBAR,3,1,4,5,0.0,1.0,0.0
CBAR,4,1,5,6,0.0,1.0,0.0
SPC1,1,123456,1,3,4
TEMPD,2,0.0
TEMP,2,1,100.0,2,100.0,3,100.0
TEMP,2,4,100.0,5,100.0,6,100.0
ENDDATA
